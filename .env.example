# Kiwoom Agent Trader environment example
# Copy to .env and fill with real values. Never commit .env.

TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_APP_KEY=replace-me
KIWOOM_SECRET_KEY=replace-me
KIWOOM_ACCOUNT_NO=replace-me

MAX_ORDER_AMOUNT_KRW=100000
MAX_DAILY_BUY_AMOUNT_KRW=300000
MAX_DAILY_LOSS_KRW=50000
ORDER_COOLDOWN_MINUTES=30

# Telegram approval bridge. TELEGRAM_BOT_TOKEN may already live in ~/.hermes/.env.
# Use the real Telegram group chat id and forum topic/thread id for production.
TELEGRAM_BOT_TOKEN=replace-me
KIWOOM_TELEGRAM_CHAT_ID=replace-me
KIWOOM_TELEGRAM_THREAD_ID=502
KIWOOM_TRADING_DB=data/trading.db
